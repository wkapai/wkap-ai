# WKAP environment. Use local on your PC and production on Render.
WKAP_ENVIRONMENT=local

# Django
SECRET_KEY=dev-only-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,wkap.ai,www.wkap.ai

# Local default: leave DATABASE_URL blank to use SQLite.
# Production: set Render Postgres DATABASE_URL.
DATABASE_URL=
DATABASE_SSLMODE=prefer

# Public/canonical URL. Local browser should use http://127.0.0.1:8000.
WKAP_BASE_URL=http://127.0.0.1:8000

# Public static HTML output and local ledger artifacts.
WKAP_PUBLIC_SITE_ROOT=public_site
WKAP_LEDGER_REPO_PATH=
WKAP_LEDGER_REPO_URL=
WKAP_LEDGER_DEPLOY_KEY_BASE64=
WKAP_LEDGER_GITHUB_BASE_URL=
WKAP_LEDGER_BRANCH=main
WKAP_GIT_EXECUTABLE=git

# Inbound sources. Local default can point at playinc@gmail.com for real email tests.
WKAP_INBOUND_EMAIL=ledger@wkap.ai
WKAP_LOCAL_INBOUND_EMAIL=playinc@gmail.com
WKAP_GMAIL_ACCOUNT=playinc@gmail.com
WKAP_RECEIPT_FROM_EMAIL=playinc@gmail.com
WKAP_SEND_RECEIPTS=false
WKAP_GMAIL_CREDENTIALS_FILE=
WKAP_GMAIL_TOKEN_FILE=
WKAP_GMAIL_TOKEN_JSON_BASE64=
WKAP_RADAR_AUTHORIZED_SENDERS=playinc@gmail.com,minxixi0103@gmail.com
WKAP_CLOUDFLARE_CACHE_PURGE_ENABLED=false
WKAP_CLOUDFLARE_ZONE_ID=
WKAP_CLOUDFLARE_API_TOKEN=

# Proof runtime. False queues proof status without requiring local OTS setup.
WKAP_OPENTIMESTAMP_ENABLED=false
WKAP_OPENTIMESTAMP_COMMAND=ots

# Production example values:
# WKAP_ENVIRONMENT=production
# DEBUG=false
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSLMODE=require
# WKAP_BASE_URL=https://wkap.ai
# WKAP_GMAIL_ACCOUNT=ledger@wkap.ai
# WKAP_RECEIPT_FROM_EMAIL=ledger@wkap.ai
# WKAP_SEND_RECEIPTS=true
# WKAP_GMAIL_TOKEN_JSON_BASE64=<base64 authorized_user token json>
# WKAP_PUBLIC_SITE_ROOT=/var/data/wkap/public_site
# WKAP_LEDGER_REPO_PATH=/var/data/wkap/ledger
# WKAP_LEDGER_REPO_URL=git@github.com:ORG/REPO.git
# WKAP_LEDGER_DEPLOY_KEY_BASE64=<base64 private deploy key>
# WKAP_LEDGER_GITHUB_BASE_URL=https://github.com/ORG/REPO/blob/main
# WKAP_CLOUDFLARE_CACHE_PURGE_ENABLED=true
# WKAP_CLOUDFLARE_ZONE_ID=<cloudflare zone id>
# WKAP_CLOUDFLARE_API_TOKEN=<api token with Zone.Cache Purge permission>
